# Required: Bot token from Discord Developer Portal -> Bot -> Reset Token
# You can also save this via: bun run configure <TOKEN>
# Use a dedicated Discord application/bot if you also run another bot (e.g. Claude).
DISCORD_BOT_TOKEN=

# Default working directory for agy sessions (defaults to current working directory)
# AGY_CWD=/path/to/your/project

# Permission mode for headless agy tool calls:
#   always-proceed               (default) Auto-runs tools while respecting deny rules in ~/.gemini/antigravity-cli/settings.json
#   accept-edits                 Auto-accepts file edits (--mode accept-edits)
#   plan                         Read-only planning mode (--mode plan)
#   default                      Uses agy default (request-review; tool calls needing approval will fail in headless mode)
#   dangerously-skip-permissions Auto-approves all tool requests (--dangerously-skip-permissions)
AGY_PERMISSION_MODE=always-proceed

# Optional: override agy binary, model, or reasoning effort (low|medium|high|xhigh|max)
# AGY_BIN=agy
# AGY_MODEL=
# AGY_EFFORT=high

# Parallel background subagents (enabled by default for fast coordinator replies & high throughput)
# Defaults to coordinator effort=low (instant replies/triage) and subagent effort=high (deep background work)
# AGY_SUBAGENTS=true
# AGY_MAX_SUBAGENTS=4
# AGY_SUBAGENT_TIMEOUT_MS=900000
# AGY_COORDINATOR_MODEL=
# AGY_COORDINATOR_EFFORT=low
# AGY_SUBAGENT_MODEL=
# AGY_SUBAGENT_EFFORT=high

# Optional: pin access.json at boot (disables runtime reload and pairing writes; downgrades pairing -> allowlist)
# DISCORD_ACCESS_MODE=static

# Optional: eager-download inbound attachments instead of on-demand via download_attachment tool (default: false)
# DISCORD_AUTO_DOWNLOAD_ATTACHMENTS=false

# Optional: close idle agy child processes after N ms (conversation ID is preserved and resumed on next message)
# AGY_IDLE_TIMEOUT_MS=1800000

# Optional: live terminal stream view of incoming messages, reasoning, tool calls, and responses (default: true)
# AGY_STREAM_LOG=true
# AGY_SHOW_THINKING=true

# Optional: custom state directory for running multiple bots on one machine (defaults to ~/.agy-discord)
# DISCORD_STATE_DIR=~/.agy-discord
